DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-use
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
LEDGER_USERNAME=kc
LEDGER_PASSWORD=replace-with-a-unique-password-at-least-16-chars
COOKIE_SECURE=0
LEDGER_BASE_CURRENCY=USD
LEDGER_TIME_ZONE=Africa/Kampala
LEDGER_DB_PATH=/app/data/ledger.sqlite3
PORT=8000
# Optional; FX refresh remains manual when no provider key is configured.
# EXCHANGERATE_HOST_ACCESS_KEY=
LEDGER_FX_CURRENCIES=EUR,GBP,UGX,CAD,AUD,JPY,CHF
# Optional backup location; defaults to /app/data/backups in Docker.
# LEDGER_BACKUP_DIR=/app/data/backups
