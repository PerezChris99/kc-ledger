# KC Ledger: set real unique values before starting the app.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-use
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
LEDGER_USERNAME=kc
LEDGER_PASSWORD=replace-with-a-unique-password-at-least-16-chars
COOKIE_SECURE=0
LEDGER_BASE_CURRENCY=USD
LEDGER_TIME_ZONE=Africa/Kampala

# Primary local PostgreSQL. Docker Compose starts its own local PostgreSQL 15
# and connects over its internal Docker network; nothing is published on port 5432.
LEDGER_DB_ENGINE=postgres
LEDGER_DB_HOST=127.0.0.1
LEDGER_DB_PORT=5432
LEDGER_DB_NAME=kc_ledger
LEDGER_DB_USER=kc_ledger
LEDGER_DB_PASSWORD=replace-with-a-unique-postgres-password
LEDGER_DB_CONNECT_TIMEOUT=3
LEDGER_DB_CONN_MAX_AGE=60

# Intentional SQLite fallback only. For a new desktop install, auto mode may
# select SQLite if local Postgres is offline and will PIN that choice for safety.
# For explicit offline usage set LEDGER_DB_ENGINE=sqlite. Never assume it
# mirrors or synchronizes data with PostgreSQL.
# LEDGER_DB_ENGINE=auto
# LEDGER_ALLOW_SQLITE_FALLBACK=1
# LEDGER_DB_PATH=./backend/data/ledger.sqlite3
# LEDGER_DB_PIN_PATH=./backend/data/.ledger-db-backend

PORT=8000
# EXCHANGERATE_HOST_ACCESS_KEY=
LEDGER_FX_CURRENCIES=EUR,GBP,UGX,CAD,AUD,JPY,CHF
# LEDGER_BACKUP_DIR=./backend/data/backups
# LEDGER_SECONDARY_BACKUP_DIR=/another-protected-drive/backups
# LEDGER_PG_BIN=C:\Program Files\PostgreSQL\17\bin

# Optional external AI advisory, disabled by default. Local scoring and pattern
# detection always work without network, tokens, API bills or model access.
# Key material stays on the server/desktop owner machine, NEVER in Git/frontend.
LEDGER_AI_ADVICE_ENABLED=0
# GEMINI_API_KEY=your-private-google-ai-studio-key
LEDGER_GEMINI_MODEL=gemini-2.5-flash-lite
# xAI Grok's public API is metered, not guaranteed free:
LEDGER_ENABLE_METERED_GROK=0
# XAI_API_KEY=your-private-xai-api-key
LEDGER_GROK_MODEL=grok-4.3

# Vercel production only (set privately in the Vercel environment, not here):
# DATABASE_URL=postgres://USER:PASS@pooled.db.prisma.io:5432/postgres?sslmode=require
# DATABASE_DIRECT_URL=postgres://USER:PASS@db.prisma.io:5432/postgres?sslmode=require
# DJANGO_ALLOWED_HOSTS=kc-ledger.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://kc-ledger.example.com
# LEDGER_DEPLOYMENT=vercel (automatically set by api/index.py)
# Do NOT reuse these cloud URLs for a distinct local Windows/SQLite ledger.
